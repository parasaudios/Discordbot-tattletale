# Bot token from Developer Portal > your app > Bot. KEEP SECRET.
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID from Developer Portal > General Information.
CLIENT_ID=your-application-id-here

# Optional: a server ID to register slash commands instantly during
# development. Leave blank to register globally (can take up to 1 hour).
# (The old name GUILD_ID is still accepted as a fallback.)
SERVER_ID=

# Optional: directory for settings.json. Set to a mounted volume path (e.g.
# /data on Railway) so config survives redeploys. Defaults to the project root.
DATA_DIR=

# Optional: enables contextual scam/abuse judging (/tattletale judge enabled:true).
# Get a key from https://console.anthropic.com . Leave blank to run without Judge.
ANTHROPIC_API_KEY=

# --- Licensing / paywall (optional) -----------------------------------------
# Your Discord USER id — required to use the owner key-management commands.
OWNER_ID=
# Your own server's id — the owner commands (genkey/revoke/keys) are registered
# ONLY here, so customers never see them. This server is also licence-exempt.
OWNER_SERVER_ID=
# Server ids that are always licensed (comma-separated) — e.g. test servers.
LICENSE_EXEMPT_SERVERS=
# Shown to unlicensed servers so buyers know where to get a key.
LICENSE_PURCHASE_URL=
